* text=auto eol=lf

# Windows command scripts must retain Windows line endings.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets are never line-ending normalized.
*.ico binary
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary
*.dmg binary
*.deb binary
*.snap binary
*.exe binary
*.dll binary
*.node binary
*.gguf binary
*.safetensors binary
